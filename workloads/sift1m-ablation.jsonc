{
  "dataset-config": "./configs/datasets.json",
  "dataset": "sift-1m",
  "metric": "euclidean",
  "warmup_runs": 5,
  "test_runs": 10,
  "indexes-config": {
    "artea": {
      "rnet_beta":               2.0,
      "l0_rnet_radius":          37844.0,
      "l0_min_distance":         1869.00,
      "ul_max_nbr_size":         32,
      "bl_max_nbr_size":         64,
      "search_nn_qs":            30,
      "ul_select_nbrs_qs":       100,
      "bl_select_nbrs_qs":       100,
      "scale_coeffs":            1.05,
      "shifted_coeffs":          1.0,
      "num_build_loops":         4,
      "num_triu_iters":          15,
      "prefill_ratio":           0.34,
      "shuffle_insertion_order": false,
      "insert_on_L0":            false,
      "throughput_search": [
        { "topk": 1, "candidate_queue_config": "1,20,1" }
      ],
      "latency_search": [
        { "topk": 1, "candidate_queue_config": "1,20,1" }
      ]
    },
    "alpha-cg": {
      "R": 50,
      "L": 40,
      "C": 500,
      "alpha_start": 0.9,
      "alpha_step": 0.05,
      "alpha_max": 1.6,
      "tau": 10.0,
      "T": 25,
      "efanna_K":      60,
      "efanna_L":      70,
      "efanna_S":      15,
      "efanna_trees":  8,
      "efanna_mlevel": 8,
      "efanna_epochs": 10,
      "efanna_checkK": 25,
      "throughput_search": [
        { "topk": 1, "candidate_queue_config": "1,20,1" }
      ],
      "latency_search": [
        { "topk": 1, "candidate_queue_config": "1,20,1" }
      ]
    }
  }
}
